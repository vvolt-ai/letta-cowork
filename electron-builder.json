{
    "appId": "com.vera.cowork",
    "productName": "Vera Cowork",
    "files": [
        "dist-electron",
        "dist-react",
        "node_modules/@letta-ai/letta-agent-sdk/**/*",
        "node_modules/@vscode/ripgrep*/**/*",
        "node_modules/@letta-ai/letta-code/**/*",
        "node_modules/ws/**/*"
    ],
    "extraResources": [
        "dist-electron/preload.cjs",
        {
            "from": "skills/email-processing",
            "to": "skills/email-processing",
            "filter": [
                "**/*"
            ]
        }
    ],
    "asarUnpack": [
        "node_modules/sharp/**/*",
        "node_modules/@img/**/*",
        "node_modules/@janhapke/sharp-electron/**/*",
        "node_modules/detect-libc/**/*",
        "node_modules/semver/**/*",
        "node_modules/@letta-ai/letta-agent-sdk/**/*",
        "node_modules/@vscode/ripgrep*/**/*",
        "node_modules/@letta-ai/letta-code/**/*",
        "node_modules/ws/**/*"
    ],
    "mac": {
        "identity": "-",
        "notarize": false,
        "target": "dmg",
        "icon": "assets/vera-icon.png"
    },
    "linux": {
        "target": "AppImage",
        "category": "Utility",
        "icon": "assets/vera-icon.png"
    },
    "win": {
        "target": [
            "portable"
        ],
        "icon": "assets/vera-icon.png"
    }
}
