# Letta Cloud (recommended for most users)
# Normal use authenticates to Vera and does not require a local Letta key.
# Optional direct fallback for offline/self-hosted development:
# LETTA_API_KEY=your-local-or-development-key
# LETTA_BASE_URL=http://localhost:8283

# Optional direct fallback agent
# LETTA_AGENT_ID=agent-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LETTA_SKIP_DEFAULT_AGENTS="true"

# =====================================
# Local Development (advanced users)
# =====================================
# Uncomment these lines to use a local Letta server instead:
# LETTA_BASE_URL=http://localhost:8283
# LETTA_API_KEY=dummy  # Local server ignores this

LETTA_NO_SYNC=true
EMAIL_SERVER_BASE_URL=https://zoho.ngrok.app
DEBUG_IPC=true

# Trusted local runtime extensions (disabled by default)
COWORK_EXTENSIONS_ENABLED=false
# Defaults to ~/.letta/extensions when empty
COWORK_EXTENSIONS_DIR=