{
  "name": "vera-cowork",
  "author": {
    "name": "Bhavesh Prajapati",
    "email": "your-email@example.com"
  },
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "letta": "which letta",
    "rebuild": "npx electron-rebuild -f",
    "dev": "concurrently -k --kill-others-on-fail \"bun run dev:react\" \"bun run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "bun run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:mac-arm64": "bun run transpile:electron && bun run build && electron-builder --mac --arm64",
    "dist:mac-x64": "bun run transpile:electron && bun run build && electron-builder --mac --x64",
    "dist:win": "bun run transpile:electron && bun run build && electron-builder --win --x64",
    "dist:linux": "bun run transpile:electron && bun run build && electron-builder --linux deb tar.xz",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@letta-ai/letta-agent-sdk": "^0.6.3",
    "@letta-ai/letta-code": "0.30.18",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@slack/bolt": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "express": "^5.2.1",
    "highlight.js": "^11.11.2",
    "node-cron": "^4.6.0",
    "os-utils": "^0.0.14",
    "picomatch": "^4.0.5",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript-lsp": "npm:typescript@^6.0.3",
    "ws": "^8.21.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/os-utils": "^0.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@xmldom/xmldom": "0.8.13",
    "app-builder-lib": "26.15.3",
    "body-parser": "2.3.0",
    "builder-util-runtime": "9.7.0",
    "fast-uri": "3.1.5",
    "form-data": "4.0.6",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "lodash": "4.18.1",
    "node-abi": "4.33.0",
    "path-to-regexp": "8.4.2",
    "qs": "6.15.3",
    "sharp": "0.35.3",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "ws": "8.21.3"
  },
  "trustedDependencies": [
    "@google/genai",
    "@letta-ai/letta-code",
    "@vscode/ripgrep",
    "@whiskeysockets/baileys",
    "electron",
    "electron-winstaller",
    "node-pty",
    "protobufjs",
    "sharp",
    "unrs-resolver"
  ]
}
