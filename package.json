{
  "name": "vera-cowork",
  "author": {
    "name": "Bhavesh Prajapati",
    "email": "your-email@example.com"
  },
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "letta": "which letta",
    "rebuild": "bunx --no-install electron-rebuild -f",
    "dev": "concurrently -k --kill-others-on-fail \"bun run dev:react\" \"bun run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development bun run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "cross-env NODE_ENV=production bun run transpile:electron && tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json && node scripts/prune-retired-runtime.mjs && node scripts/write-app-build-mode.mjs",
    "dist:mac-arm64": "bun run build && electron-builder --mac --arm64 --publish never",
    "dist:mac-x64": "bun run build && electron-builder --mac --x64 --publish never",
    "dist:win": "bun run build && electron-builder --win --x64 --publish never",
    "dist:linux": "bun run build && electron-builder --linux deb tar.xz --publish never",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@letta-ai/letta-agent-sdk": "0.8.81",
    "@letta-ai/letta-client": "1.12.1",
    "@letta-ai/letta-code": "0.34.51",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@slack/bolt": "^5.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vscode/ripgrep": "1.18.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "electron-store": "^12.0.0",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "jsonc-parser": "3.3.1",
    "node-cron": "^4.6.0",
    "os-utils": "^0.0.14",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "playwright": "^1.65.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript-lsp": "npm:typescript@6.0.3",
    "ws": "8.22.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/os-utils": "^0.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "dmg-builder": "26.18.0",
    "electron": "45.3.0",
    "electron-builder": "^26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@humanfs/node": "0.16.8",
    "baseline-browser-mapping": "2.11.35",
    "browserslist": "4.29.5",
    "hono": "4.13.18",
    "music-metadata": "11.16.0",
    "zod": "4.6.7",
    "proxy-addr": "2.0.8",
    "@xmldom/xmldom": "0.8.15",
    "app-builder-lib": "26.18.0",
    "dmg-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "body-parser": "2.4.0",
    "builder-util-runtime": "9.7.0",
    "fast-uri": "3.1.9",
    "form-data": "4.0.6",
    "ip-address": "10.7.6",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "node-abi": "4.40.0",
    "path-to-regexp": "8.4.2",
    "qs": "6.17.1",
    "sharp": "0.35.5",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "ws": "8.22.2"
  },
  "trustedDependencies": [
    "@google/genai",
    "@letta-ai/letta-code",
    "@vscode/ripgrep",
    "@whiskeysockets/baileys",
    "electron",
    "electron-winstaller",
    "node-pty",
    "protobufjs",
    "sharp",
    "unrs-resolver"
  ]
}
