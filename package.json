{
  "name": "vera-cowork",
  "author": {
    "name": "Bhavesh Prajapati",
    "email": "your-email@example.com"
  },
  "private": true,
  "version": "0.8.5",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "letta": "which letta",
    "rebuild": "npx electron-rebuild -f",
    "dev": "concurrently -k --kill-others-on-fail \"bun run dev:react\" \"bun run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "bun run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:mac-arm64": "bun run transpile:electron && bun run build && electron-builder --mac --arm64",
    "dist:mac-x64": "bun run transpile:electron && bun run build && electron-builder --mac --x64",
    "dist:win": "bun run transpile:electron && bun run build && electron-builder --win --x64",
    "dist:linux": "bun run transpile:electron && bun run build && electron-builder --linux deb tar.xz",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@letta-ai/letta-code-sdk": "^0.2.1",
    "@radix-ui/react-dialog": "^1.1.22",
    "@radix-ui/react-dropdown-menu": "^2.1.23",
    "@slack/bolt": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "node-cron": "^4.6.0",
    "os-utils": "^0.0.14",
    "picomatch": "^4.0.5",
    "pino": "^10.3.1",
    "playwright": "^1.62.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript-lsp": "npm:typescript@5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/os-utils": "^0.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "node-abi": "4.33.0"
  },
  "trustedDependencies": [
    "@google/genai",
    "@letta-ai/letta-code",
    "@vscode/ripgrep",
    "@whiskeysockets/baileys",
    "electron",
    "electron-winstaller",
    "node-pty",
    "protobufjs",
    "sharp",
    "unrs-resolver"
  ]
}
